    "@testing-library/jest-dom": "~6.6.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.5",
