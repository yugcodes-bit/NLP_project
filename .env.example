# ---- API (services/api) ----
PORT=8080
MODEL_DIR=/app/model                 # local dir with model_quantized.onnx, tokenizer.json, model-meta.json
# Local development: build the random dev model with
#   uv run python -m bhaav_api.devtools.dummy_model --out dist/dummy
# and set MODEL_DIR=dist/dummy (path is relative to where you start uvicorn).
MODEL_REPO=bhaav/teacher-onnx        # HF Hub repo pulled at docker build
MODEL_REVISION=v1.0.0
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE=60/minute
RATE_LIMIT_BATCH=10/minute
MAX_TEXT_CHARS=1000
EXPLAIN_MAX_WORDS=40
FEEDBACK_ENABLED=false
LOG_LEVEL=info

# ---- Optional (later) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Web (apps/web) ----
# Next.js reads these from apps/web/.env.local (not from this root file). The default API URL
# when nothing is set is http://localhost:8080.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STUDENT_REPO=bhaav/student-onnx
NEXT_PUBLIC_MODEL_REVISION=v1.0.0

# ---- Research only (never used by the website) ----
HF_TOKEN=
# Gemini is the hosted LLM for the baseline experiments (B5/B6, Phase 3) and silver data (Phase 5).
# Create the key in Google AI Studio (a Gemini app subscription alone is not an API key).
# Copy this file to .env and paste the key there. Never commit .env or paste the key in chat.
GEMINI_API_KEY=
