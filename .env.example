# ---- API (services/api) ----
PORT=8080
MODEL_DIR=/app/model                 # local dir with model_quantized.onnx, tokenizer.json, model-meta.json
MODEL_REPO=bhaav/teacher-onnx        # HF Hub repo pulled at docker build
MODEL_REVISION=v1.0.0
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE=60/minute
RATE_LIMIT_BATCH=10/minute
MAX_TEXT_CHARS=1000
EXPLAIN_MAX_WORDS=40
FEEDBACK_ENABLED=false
LOG_LEVEL=info

# ---- Optional (later) ----
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_STUDENT_REPO=bhaav/student-onnx
NEXT_PUBLIC_MODEL_REVISION=v1.0.0

# ---- Research only (never used by the website) ----
HF_TOKEN=
GEMINI_API_KEY=
